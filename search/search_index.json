{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u623f\u4ea7\u8bc1\u5236\u4f5c\u4e0d\u52a8\u4ea7\u6743\u8bc1\u4e66\u529e\u7406\uff0c\u5927\u7ea2\u672c\u6837\u5f0f\u516c\u5f00","text":"<p>\u5728\u623f\u4ea7\u4ea4\u6613\u6216\u8d44\u4ea7\u767b\u8bb0\u4e2d\uff0c\u4e0d\u52a8\u4ea7\u6743\u8bc1\u4e66\uff08\u4fd7\u79f0\u201c\u5927\u7ea2\u672c\u201d\uff09\u662f\u6240\u6709\u6743\u4eba\u5408\u6cd5\u62e5\u6709\u623f\u5c4b\u53ca\u571f\u5730\u4f7f\u7528\u6743\u7684\u6838\u5fc3\u51ed\u8bc1\u3002\u968f\u7740\u4e2d\u56fd\u56fd\u5bb6\u4e0d\u52a8\u4ea7\u7edf\u4e00\u767b\u8bb0\u5236\u5ea6\u7684\u5168\u9762\u843d\u5730\uff0c\u4f20\u7edf\u7684\u201c\u623f\u4ea7\u8bc1\u201d\u5df2\u6b63\u5f0f\u5347\u7ea7\u4e3a\u5408\u5e76\u540e\u7684\u201c\u4e0d\u52a8\u4ea7\u6743\u8bc1\u4e66\u201d\u3002</p> <p></p> <p>\u672c\u6587\u5c06\u4e3a\u60a8\u6df1\u5ea6\u89e3\u6790\u4e0d\u52a8\u4ea7\u6743\u8bc1\u4e66\u529e\u7406\u7684\u5b8c\u6574\u6d41\u7a0b\u3001\u6700\u65b0\u201c\u5927\u7ea2\u672c\u201d\u7684\u5b98\u65b9\u6837\u5f0f\u4e0e\u9632\u4f2a\u7279\u5f81\uff0c\u5e76\u89e3\u7b54\u5728\u529e\u7406\u548c\u5236\u4f5c\u8fc7\u7a0b\u4e2d\u7684\u6838\u5fc3\u6cd5\u5f8b\u5e38\u8bc6\uff0c\u5e2e\u52a9\u60a8\u9ad8\u6548\u3001\u5408\u89c4\u5730\u62ff\u5230\u5c5e\u4e8e\u81ea\u5df1\u7684\u8d44\u4ea7\u76fe\u724c\u3002</p>"},{"location":"#_2","title":"\u4e00\u3001 \u623f\u4ea7\u8bc1\u4e0e\u4e0d\u52a8\u4ea7\u6743\u8bc1\u4e66\u6709\u4ec0\u4e48\u533a\u522b\uff1f","text":"<p>\u8bb8\u591a\u4e1a\u4e3b\u5e38\u5e38\u6df7\u6dc6\u201c\u623f\u4ea7\u8bc1\u201d\u4e0e\u201c\u4e0d\u52a8\u4ea7\u6743\u8bc1\u4e66\u201d\u7684\u6982\u5ff5\u3002\u7b80\u5355\u6765\u8bf4\uff0c\u8fd9\u662f\u56fd\u5bb6\u884c\u653f\u5ba1\u6279\u5236\u5ea6\u6539\u9769\u524d\u540e\u7684\u4e24\u4ee3\u4ea7\u7269\uff1a</p> <ul> <li>\u65e7\u7248\u623f\u4ea7\u8bc1\uff08\u623f\u5c4b\u6240\u6709\u6743\u8bc1\uff09\uff1a \u8fc7\u53bb\u5b9e\u884c\u201c\u623f\u5730\u5206\u79bb\u201d\uff0c\u8d2d\u623f\u8005\u9700\u8981\u5206\u522b\u529e\u7406\u300a\u623f\u5c4b\u6240\u6709\u6743\u8bc1\u300b\u548c\u300a\u56fd\u6709\u571f\u5730\u4f7f\u7528\u6743\u8bc1\u300b\u3002</li> <li>\u65b0\u7248\u4e0d\u52a8\u4ea7\u6743\u8bc1\u4e66\uff08\u5927\u7ea2\u672c\uff09\uff1a \u5982\u4eca\u5b9e\u884c\u201c\u623f\u5730\u4e00\u4f53\u201d\u767b\u8bb0\u3002\u65b0\u8bc1\u4e66\u5c06\u623f\u5c4b\u6240\u6709\u6743\u3001\u571f\u5730\u4f7f\u7528\u6743\u3001\u6d77\u57df\u4f7f\u7528\u6743\u7b49\u7edf\u4e00\u5408\u5e76\u3002\u65b0\u7248\u4e0d\u52a8\u4ea7\u6743\u8bc1\u4e66\u5728\u6cd5\u5f8b\u6548\u529b\u3001\u4fe1\u606f\u900f\u660e\u5ea6\u548c\u9632\u4f2a\u6027\u80fd\u4e0a\uff0c\u5747\u5168\u9762\u8d85\u8d8a\u4e86\u4f20\u7edf\u623f\u4ea7\u8bc1\u3002</li> </ul> <p>\u653f\u7b56\u63d0\u793a\uff1a \u6309\u7167\u201c\u4e0d\u53d8\u52a8\u4e0d\u6362\u8bc1\u201d\u7684\u539f\u5219\uff0c\u65e7\u7248\u623f\u4ea7\u8bc1\u53ea\u8981\u4e0d\u53d1\u751f\u4e70\u5356\u3001\u8d60\u4e88\u3001\u66f4\u540d\u7b49\u53d8\u66f4\uff0c\u4f9d\u7136\u5177\u6709\u6cd5\u5f8b\u6548\u529b\uff0c\u65e0\u9700\u5f3a\u5236\u66f4\u6362\u3002\u4f46\u65b0\u529e\u7406\u7684\u767b\u8bb0\u4e00\u5f8b\u6838\u53d1\u65b0\u7248\u4e0d\u52a8\u4ea7\u6743\u8bc1\u4e66\u3002</p>"},{"location":"#_3","title":"\u4e8c\u3001 \u6700\u65b0\u4e0d\u52a8\u4ea7\u6743\u8bc1\u4e66\u201c\u5927\u7ea2\u672c\u201d\u6837\u5f0f\u516c\u5f00","text":"<p>\u5728\u8c37\u6b4c\u56fe\u7247\u6216\u767e\u5ea6\u56fe\u7247\u4e2d\uff0c\u4e0d\u52a8\u4ea7\u6743\u8bc1\u4e66\u6837\u672c\u4e0e\u5927\u7ea2\u672c\u6837\u5f0f\u4e00\u76f4\u662f\u9ad8\u9891\u641c\u7d22\u70ed\u8bcd\u3002\u4e3a\u4e86\u8ba9\u5927\u5bb6\u80fd\u6e05\u6670\u8fa8\u522b\u771f\u4f2a\uff0c\u5b98\u65b9\u89c4\u8303\u7684\u201c\u5927\u7ea2\u672c\u201d\u5177\u5907\u4ee5\u4e0b\u663e\u8457\u7684\u5916\u89c2\u4e0e\u5185\u90e8\u7279\u5f81\uff1a</p>"},{"location":"#1","title":"1. \u5c01\u9762\u4e0e\u6750\u8d28","text":"<ul> <li>\u5c01\u9762\u989c\u8272\uff1a \u8bc1\u4e66\u5c01\u9762\u4e3a\u6df1\u7edb\u7ea2\u8272\uff0c\u8d28\u5730\u575a\u633a\uff0c\u6b63\u9762\u5370\u6709\u91d1\u8272\u7684\u56fd\u5fbd\uff0c\u4e0b\u65b9\u5370\u6709\u201c\u4e0d\u52a8\u4ea7\u6743\u8bc1\u4e66\u201d\u5b57\u6837\u3002</li> <li>\u82f1\u6587\u6807\u6ce8\uff1a \u5e95\u90e8\u5e26\u6709\u82f1\u6587\u201cReal Estate Investment Certificate\u201d\u5b57\u6837\uff0c\u63d0\u5347\u4e86\u6d89\u5916\u4e8b\u52a1\u4e2d\u7684\u53ef\u8bc6\u522b\u5ea6\u3002</li> </ul>"},{"location":"#2","title":"2. \u5185\u9875\u6838\u5fc3\u4fe1\u606f","text":"<p>\u6253\u5f00\u8bc1\u4e66\uff0c\u5185\u9875\u91c7\u7528\u7279\u5236\u9632\u4f2a\u7eb8\u5f20\uff0c\u4e3b\u8981\u5305\u542b\u4ee5\u4e0b\u5173\u952e\u767b\u8bb0\u8981\u7d20\uff1a *   \u4e0d\u52a8\u4ea7\u6743\u8bc1\u4e66\u53f7\uff1a \u4f8b\u5982\u201c\u67d0\uff082026\uff09\u67d0\u5e02\u4e0d\u52a8\u4ea7\u6743\u7b2cXXXXXX\u53f7\u201d\u3002 *   \u6743\u5229\u4eba\uff1a \u623f\u5c4b\u6240\u6709\u6743\u4eba\u7684\u59d3\u540d\u6216\u516c\u53f8\u540d\u79f0\u3002 *   \u5171\u6709\u60c5\u51b5\uff1a \u660e\u786e\u6807\u6ce8\u662f\u5355\u72ec\u6240\u6709\u3001\u5171\u540c\u5171\u6709\u8fd8\u662f\u6309\u4efd\u5171\u6709\u3002 *   \u5750\u843d\uff1a \u623f\u5c4b\u7684\u8be6\u7ec6\u6cd5\u5b9a\u5177\u4f53\u5730\u5740\u3002 *   \u4e0d\u52a8\u4ea7\u5355\u5143\u53f7\uff1a \u76f8\u5f53\u4e8e\u623f\u5c4b\u7684\u201c\u8eab\u4efd\u8bc1\u53f7\u201d\uff0c\u5168\u56fd\u552f\u4e00\uff0c\u753128\u4f4d\u6570\u5b57\u548c\u5b57\u6bcd\u7ec4\u6210\u3002 *   \u6743\u5229\u7c7b\u578b/\u6743\u5229\u6027\u8d28\uff1a \u5982\u201c\u56fd\u6709\u5efa\u8bbe\u7528\u5730\u4f7f\u7528\u6743/\u623f\u5c4b\u6240\u6709\u6743\u201d\uff0c\u6027\u8d28\u4e3a\u201c\u51fa\u8ba9/\u5546\u54c1\u623f\u201d\u7b49\u3002 *   \u7528\u9014/\u9762\u79ef\uff1a \u6807\u6ce8\u571f\u5730\u4e0e\u623f\u5c4b\u7684\u7528\u9014\uff08\u5982\u4f4f\u5b85\uff09\u4ee5\u53ca\u5177\u4f53\u7684\u5efa\u7b51\u9762\u79ef\u3002 *   \u4f7f\u7528\u671f\u9650\uff1a \u660e\u786e\u6807\u51fa\u571f\u5730\u4f7f\u7528\u6743\u7684\u8d77\u6b62\u65e5\u671f\uff08\u5982\u4f4f\u5b85\u768470\u5e74\u4ea7\u6743\u671f\u9650\uff09\u3002</p>"},{"location":"#3","title":"3. \u9644\u56fe\u9875","text":"<p>\u8bc1\u4e66\u80cc\u9762\u901a\u5e38\u9644\u6709\u5b97\u5730\u56fe\u548c\u623f\u4ea7\u5206\u6237\u56fe\uff0c\u8be6\u7ec6\u63cf\u7ed8\u4e86\u623f\u5c4b\u7684\u51e0\u4f55\u5750\u6807\u3001\u8fb9\u754c\u4ee5\u53ca\u5957\u5185\u7ed3\u6784\u6237\u578b\u3002</p>"},{"location":"#_4","title":"\u4e09\u3001 \u89c4\u8303\u7684\u4e0d\u52a8\u4ea7\u6743\u8bc1\u4e66\u529e\u7406\u6d41\u7a0b","text":"<p>\u65e0\u8bba\u662f\u65b0\u623f\u4ea4\u4ed8\u3001\u4e8c\u624b\u623f\u8fc7\u6237\uff0c\u8fd8\u662f\u7ee7\u627f\u8d60\u4e88\uff0c\u4e0d\u52a8\u4ea7\u6743\u8bc1\u4e66\u529e\u7406\u90fd\u9700\u8981\u9075\u5faa\u4e25\u683c\u7684\u6cd5\u5b9a\u884c\u653f\u5ba1\u6279\u6d41\u7a0b\uff1a</p> <ol> <li>\u51c6\u5907\u6838\u5fc3\u6750\u6599\uff1a<ul> <li>\u4e70\u5356\u53cc\u65b9\u8eab\u4efd\u8bc1\u4ef6\u3001\u6237\u53e3\u672c\u3001\u5a5a\u59fb\u72b6\u51b5\u8bc1\u660e\u3002</li> <li>\u5546\u54c1\u623f\u4e70\u5356\u5408\u540c\u3001\u53d1\u7968\u6216\u4e8c\u624b\u623f\u8fc7\u6237\u7f51\u7b7e\u5408\u540c\u3002</li> <li>\u5b8c\u7a0e\u51ed\u8bc1\uff08\u5951\u7a0e\u3001\u589e\u503c\u7a0e\u3001\u4e2a\u4eba\u6240\u5f97\u7a0e\u7b49\uff09\u3002</li> </ul> </li> <li>\u63d0\u4ea4\u7533\u8bf7\u4e0e\u5ba1\u6838\uff1a \u5f53\u4e8b\u4eba\u524d\u5f80\u5f53\u5730\u4e0d\u52a8\u4ea7\u767b\u8bb0\u5c40\u7a97\u53e3\uff08\u6216\u901a\u8fc7\u653f\u52a1\u670d\u52a1\u7f51\u3001\u5fae\u653f\u52a1App\uff09\u63d0\u4ea4\u7533\u8bf7\u3002\u767b\u8bb0\u673a\u6784\u4f1a\u5bf9\u623f\u5c4b\u662f\u5426\u5b58\u5728\u62b5\u62bc\u3001\u67e5\u5c01\u7b49\u9650\u5236\u72b6\u6001\u8fdb\u884c\u4e25\u683c\u5ba1\u6838\u3002</li> <li>\u4ea4\u8d39\u9886\u8bc1\uff1a \u5ba1\u6838\u901a\u8fc7\u540e\uff0c\u7f34\u7eb3\u89c4\u5b9a\u7684\u4e0d\u52a8\u4ea7\u767b\u8bb0\u8d39\uff08\u4f4f\u5b85\u901a\u5e38\u4e3a80\u5143/\u672c\uff09\uff0c\u5373\u53ef\u9886\u53d6\u70ed\u817e\u817e\u7684\u201c\u5927\u7ea2\u672c\u201d\u5b9e\u4f53\u8bc1\u4e66\u3002</li> </ol>"},{"location":"#_5","title":"\u56db\u3001 \u6570\u5b57\u5316\u65f6\u4ee3\uff1a\u7535\u5b50\u4e0d\u52a8\u4ea7\u6743\u8bc1\u4e66\u7684\u5d1b\u8d77","text":"<p>\u968f\u7740\u201c\u4e92\u8054\u7f51+\u653f\u52a1\u670d\u52a1\u201d\u7684\u666e\u53ca\uff0c\u76ee\u524d\u5168\u56fd\u7edd\u5927\u591a\u6570\u57ce\u5e02\u5747\u5df2\u5f00\u901a\u7535\u5b50\u4e0d\u52a8\u4ea7\u6743\u8bc1\u4e66\u3002</p> <ul> <li>\u5982\u4f55\u67e5\u8be2\uff1a \u4e1a\u4e3b\u53ef\u901a\u8fc7\u56fd\u5bb6\u653f\u52a1\u670d\u52a1\u5e73\u53f0\u3001\u5730\u65b9\u653f\u52a1APP\uff08\u5982\u968f\u7533\u529e\u3001\u7ca4\u7701\u4e8b\uff09\u6216\u5f53\u5730\u4e0d\u52a8\u4ea7\u767b\u8bb0\u4e2d\u5fc3\u5b98\u65b9\u5e73\u53f0\uff0c\u76f4\u63a5\u7ed1\u5b9a\u5e76\u67e5\u770b\u81ea\u5df1\u7684\u7535\u5b50\u5927\u7ea2\u672c\u3002</li> <li>\u6cd5\u5f8b\u6548\u529b\uff1a \u7535\u5b50\u8bc1\u4e66\u4e0e\u7eb8\u8d28\u201c\u5927\u7ea2\u672c\u201d\u5177\u6709\u540c\u7b49\u7684\u6cd5\u5f8b\u6548\u529b\u3002\u5728\u529e\u7406\u843d\u6237\u3001\u5b50\u5973\u5165\u5b66\u3001\u516c\u79ef\u91d1\u63d0\u53d6\u3001\u94f6\u884c\u8d37\u6b3e\u7b49\u9ad8\u9891\u653f\u52a1\u4e8b\u52a1\u65f6\uff0c\u53ef\u76f4\u63a5\u51fa\u793a\u7535\u5b50\u8bc1\u4e66\u4e8c\u7ef4\u7801\uff0c\u65e0\u9700\u518d\u643a\u5e26\u7eb8\u8d28\u539f\u4ef6\u3002</li> </ul>"},{"location":"#_6","title":"\u4e94\u3001 \u603b\u7ed3\u4e0e\u98ce\u9669\u63d0\u793a","text":"<p>\u4f9d\u6cd5\u5408\u89c4\u7684\u4e0d\u52a8\u4ea7\u6743\u8bc1\u4e66\u529e\u7406\uff0c\u662f\u4fdd\u969c\u4e2a\u4eba\u5408\u6cd5\u79c1\u6709\u8d22\u4ea7\u4e0d\u88ab\u4fb5\u72af\u7684\u6700\u9ad8\u6cd5\u5f8b\u624b\u6bb5\u3002</p> <p>\u4e25\u6b63\u58f0\u660e\uff1a \u4e0d\u52a8\u4ea7\u6743\u8bc1\u4e66\u7531\u5404\u7ea7\u4eba\u6c11\u653f\u5e9c\u4f9d\u6cd5\u7edf\u4e00\u76d1\u5236\u548c\u6838\u53d1\uff0c\u5177\u5907\u6781\u4e3a\u4e25\u5bc6\u7684\u8054\u7f51\u6570\u5b57\u5316\u5907\u6848\u7cfb\u7edf\u3002\u4efb\u4f55\u79c1\u81ea\u5236\u9020\u3001\u4e70\u5356\u3001\u6d82\u6539\u6216\u4f7f\u7528\u5047\u5192\u623f\u4ea7\u8bc1\u4e0e\u4e0d\u52a8\u4ea7\u6743\u8bc1\u4e66\u7684\u884c\u4e3a\uff0c\u5747\u6784\u6210\u8fdd\u6cd5\u72af\u7f6a\u3002\u5404\u884c\u653f\u673a\u5173\u3001\u94f6\u884c\u91d1\u878d\u673a\u6784\u5728\u5ba1\u67e5\u65f6\uff0c\u5747\u4f1a\u901a\u8fc7\u7cfb\u7edf\u5185\u90e8\u7f51\u7edc\u6838\u9a8c\u5176\u4e0d\u52a8\u4ea7\u5355\u5143\u53f7\u53ca\u6743\u5229\u4eba\u771f\u4f2a\uff0c\u5207\u52ff\u62b1\u6709\u4fa5\u5e78\u5fc3\u7406\u3002</p>"}]}