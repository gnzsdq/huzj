{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"Home","text":""},{"location":"#_1","title":"\u623f\u4ea7\u8bc1\u4ece\u529e\u7406\u5230\u5b98\u65b9\u5236\u4f5c\u9700\u8981\u591a\u4e45\uff1f\u4e0d\u52a8\u4ea7\u6743\u8bc1\u4e66\u6700\u65b0\u6d41\u7a0b\u89e3\u6790","text":"<p>\u5bf9\u4e8e\u7edd\u5927\u591a\u6570\u8d2d\u623f\u8005\u800c\u8a00\uff0c\u4ece\u7b7e\u4e0b\u8d2d\u623f\u5408\u540c\u3001\u4ea4\u4ed8\u623f\u6b3e\uff0c\u5230\u6700\u7ec8\u5c06\u90a3\u672c\u7ea2\u5e95\u91d1\u5b57\u7684\u4e0d\u52a8\u4ea7\u6743\u8bc1\u4e66\uff08\u4fd7\u79f0\u65b0\u7248\u623f\u4ea7\u8bc1\uff09\u63e1\u5728\u624b\u4e2d\uff0c\u624d\u7b97\u771f\u6b63\u5b8c\u6210\u4e86\u5fc3\u7406\u4e0a\u7684\u201c\u5b89\u5bb6\u843d\u6237\u201d\u3002\u7136\u800c\uff0c\u5728\u5b9e\u9645\u64cd\u4f5c\u4e2d\uff0c\u201c\u7b49\u8bc1\u201d\u5f80\u5f80\u662f\u4e00\u4e2a\u6f2b\u957f\u4e14\u4ee4\u4eba\u7126\u8651\u7684\u8fc7\u7a0b\u3002</p> <p></p> <p>\u8bb8\u591a\u4e1a\u4e3b\u7ecf\u5e38\u5728\u5404\u5927\u6c11\u751f\u677f\u5757\u54a8\u8be2\uff1a\u201c\u4e0d\u52a8\u4ea7\u6743\u8bc1\u4e66\u63d0\u4ea4\u7533\u8bf7\u540e\uff0c\u5b98\u65b9\u5236\u4f5c\u5230\u5e95\u9700\u8981\u591a\u5c11\u4e2a\u5de5\u4f5c\u65e5\uff1f\u201d\u201c\u4e3a\u4ec0\u4e48\u90bb\u5c45\u7684\u8bc1\u4e0b\u6765\u4e86\uff0c\u6211\u7684\u8fd8\u5728\u5ba1\u6279\u4e2d\uff1f\u201d</p> <p>\u5982\u4eca\uff0c\u968f\u7740\u5404\u5730\u4e0d\u52a8\u4ea7\u767b\u8bb0\u5c40\u201c\u653e\u7ba1\u670d\u201d\u6539\u9769\u7684\u6301\u7eed\u6df1\u5316\uff0c\u8bc1\u4e66\u7684\u529e\u7406\u65f6\u6548\u4e0e\u5236\u4f5c\u6d41\u7a0b\u5df2\u7ecf\u5b9e\u73b0\u4e86\u5927\u5e45\u5ea6\u7684\u63d0\u901f\u3002\u672c\u6587\u5c06\u4e3a\u60a8\u5168\u65b9\u4f4d\u62c6\u89e3\u6700\u65b0\u7684\u4e0d\u52a8\u4ea7\u6743\u8bc1\u4e66\u5b98\u65b9\u5236\u4f5c\u5468\u671f\u3001\u6838\u5fc3\u5ba1\u6279\u6d41\u7a0b\u4ee5\u53ca\u9886\u8bc1\u524d\u7684\u5173\u952e\u51c6\u5907\u5de5\u4f5c\uff0c\u5e2e\u52a9\u60a8\u505a\u5230\u5fc3\u4e2d\u6709\u6570\uff0c\u544a\u522b\u76f2\u76ee\u7b49\u5f85\u3002</p>"},{"location":"#_2","title":"\u4e00\u3001 \u4e0d\u52a8\u4ea7\u6743\u8bc1\u4e66\u529e\u7406\u65f6\u9650\uff1a\u5b98\u65b9\u5236\u4f5c\u4e0e\u51fa\u8bc1\u7a76\u7adf\u9700\u8981\u51e0\u5929\uff1f","text":"<p>\u6839\u636e\u5404\u5927\u653f\u52a1\u670d\u52a1\u5e73\u53f0\u53ca\u623f\u4ea7\u5e02\u573a\u7684\u6838\u5fc3\u641c\u7d22\u70ed\u5ea6\u6765\u770b\uff0c\u201c\u623f\u4ea7\u8bc1\u529e\u4e0b\u6765\u8981\u591a\u4e45\u201d\u4ee5\u53ca\u201c\u4e0d\u52a8\u4ea7\u6743\u8bc1\u5236\u4f5c\u5468\u671f\u201d\u59cb\u7ec8\u662f\u9ad8\u5c45\u4e0d\u4e0b\u7684\u6838\u5fc3\u75db\u70b9\u3002\u4e8b\u5b9e\u4e0a\uff0c\u8bc1\u4e66\u7684\u5b98\u65b9\u5236\u4f5c\u4e0e\u53d1\u653e\u65f6\u95f4\uff0c\u5e76\u4e0d\u80fd\u4e00\u6982\u800c\u8bba\uff0c\u5b83\u53d6\u51b3\u4e8e\u4f60\u6240\u5904\u7684\u623f\u4ea7\u4ea4\u6613\u7c7b\u578b\uff1a</p>"},{"location":"#1","title":"1. \u65b0\u623f\uff08\u5546\u54c1\u623f\uff09\u9996\u6b21\u8f6c\u79fb\u767b\u8bb0","text":"<p>\u5728\u5f00\u53d1\u5546\u5df2\u7ecf\u5b8c\u6210\u201c\u5927\u8bc1\u201d\uff08\u521d\u59cb\u767b\u8bb0\uff09\u7684\u524d\u63d0\u4e0b\uff0c\u4e1a\u4e3b\u4e2a\u4eba\u524d\u5f80\u4e0d\u52a8\u4ea7\u767b\u8bb0\u4e2d\u5fc3\u7a97\u53e3\uff08\u6216\u7ebf\u4e0a\u653f\u52a1\u7cfb\u7edf\uff09\u63d0\u4ea4\u4e2a\u4eba\u529e\u8bc1\u7533\u8bf7\u3002 * \u5e38\u89c4\u57ce\u5e02\u5468\u671f\uff1a \u5b98\u65b9\u6536\u4ef6\u53d7\u7406\u540e\uff0c\u901a\u5e38\u5728 3\u81f35\u4e2a\u5de5\u4f5c\u65e5 \u5185\u5b8c\u6210\u5ba1\u6838\u5e76\u5236\u4f5c\u51fa\u8bc1\u3002 * \u9ad8\u6548\u793a\u8303\u57ce\u5e02\uff1a \u8bb8\u591a\u5730\u533a\u5df2\u63a8\u884c\u201c\u4ea4\u623f\u5373\u4ea4\u8bc1\u201d\u653f\u7b56\uff0c\u5728\u6536\u623f\u5f53\u5929\uff0c\u5b98\u65b9\u5236\u8bc1\u7cfb\u7edf\u5c31\u5df2\u7ecf\u5b8c\u6210\u4e86\u8bc1\u4e66\u7684\u5236\u4f5c\u4e0e\u6253\u5370\u3002</p>"},{"location":"#2","title":"2. \u4e8c\u624b\u623f\u4e70\u5356\uff08\u5b58\u91cf\u623f\u8f6c\u79fb\u767b\u8bb0\uff09","text":"<p>\u4e8c\u624b\u623f\u4ea4\u6613\u6d89\u53ca\u4e70\u5356\u53cc\u65b9\u7684\u8eab\u4efd\u6838\u9a8c\u3001\u623f\u4ea7\u6838\u67e5\u4ee5\u53ca\u7a0e\u8d39\u6e05\u7f34\u3002 * \u6807\u51c6\u65f6\u6548\uff1a \u7a97\u53e3\u6b63\u5f0f\u6536\u4ef6\u540e\uff0c\u666e\u904d\u5728 1\u81f33\u4e2a\u5de5\u4f5c\u65e5 \u5185\u5b8c\u6210\u5b98\u65b9\u5236\u4f5c\u3002 * \u4e00\u7a97\u53d7\u7406\u533a\u57df\uff1a \u5728\u5b9e\u73b0\u4e86\u7a0e\u52a1\u3001\u623f\u7ba1\u3001\u4e0d\u52a8\u4ea7\u201c\u4e09\u5408\u4e00\u201d\u7684\u4e00\u7a97\u5f0f\u670d\u52a1\u4e2d\u5fc3\uff0c\u6700\u5feb\u53ef\u5b9e\u73b0 \u5f53\u65e5\u7533\u8bf7\u3001\u5f53\u65e5\u5236\u4f5c\u3001\u5f53\u65e5\u62ff\u8bc1\u3002</p>"},{"location":"#3","title":"3. \u9057\u5931\u8865\u529e\u6216\u53d8\u66f4\u767b\u8bb0","text":"<p>\u5982\u679c\u662f\u8bc1\u4e66\u6c61\u635f\u3001\u9057\u5931\u7533\u8bf7\u8865\u53d1\uff0c\u6216\u8005\u5a5a\u59fb\u5173\u7cfb\u53d8\u52a8\u5bfc\u81f4\u7684\u540d\u5b57\u53d8\u66f4\uff1a * \u8865\u53d1\u5468\u671f\uff1a \u6392\u9664\u524d\u671f\u6cd5\u5b9a\u7684\u9057\u5931\u58f0\u660e\u516c\u544a\u671f\uff08\u901a\u5e38\u4e3a15\u4e2a\u5de5\u4f5c\u65e5\uff09\u5916\uff0c\u5b98\u65b9\u7cfb\u7edf\u91cd\u65b0\u5236\u4f5c\u3001\u7f2e\u5370\u65b0\u8bc1\u4e66\u7684\u65f6\u95f4\u4e00\u822c\u53ea\u9700 1\u81f32\u4e2a\u5de5\u4f5c\u65e5\u3002</p>"},{"location":"#_3","title":"\u4e8c\u3001 \u62c6\u89e3\u4e0d\u52a8\u4ea7\u767b\u8bb0\u6838\u5fc3\u6b65\u9aa4\uff1a\u4ece\u63d0\u4ea4\u7533\u8bf7\u5230\u5b98\u65b9\u201c\u7f2e\u8bc1\u201d\u6253\u5370","text":"<p>\u4e3a\u4e86\u8ba9\u5927\u5bb6\u660e\u767d\u65f6\u95f4\u90fd\u82b1\u5728\u4e86\u54ea\u91cc\uff0c\u6211\u4eec\u9700\u8981\u900f\u89c6\u4e0d\u52a8\u4ea7\u767b\u8bb0\u4e2d\u5fc3\u5185\u90e8\u7684\u8fd0\u4f5c\u6d41\u6c34\u7ebf\u3002\u4e00\u672c\u5408\u6cd5\u5408\u89c4\u7684\u4e0d\u52a8\u4ea7\u6743\u8bc1\u4e66\uff0c\u5fc5\u987b\u5386\u7ecf\u4ee5\u4e0b\u56db\u4e2a\u6cd5\u5b9a\u7684\u7cfb\u7edf\u5316\u6b65\u9aa4\uff1a</p>"},{"location":"#_4","title":"\ud83c\udfc1 \u6b65\u9aa4\u4e00\uff1a\u7a97\u53e3\u6536\u4ef6\u4e0e\u6750\u6599\u521d\u5ba1\uff08\u5f53\u5929\u5b8c\u6210\uff09","text":"<p>\u5f53\u4e8b\u4eba\u5c06\u51c6\u5907\u597d\u7684\u8eab\u4efd\u8bc1\u660e\u3001\u8d2d\u623f\u5408\u540c\u3001\u53d1\u7968\u7b49\u8d44\u6599\u9012\u4ea4\u81f3\u767b\u8bb0\u7a97\u53e3\u3002\u7a97\u53e3\u5de5\u4f5c\u4eba\u5458\u4f1a\u5bf9\u8d44\u6599\u7684\u5b8c\u6574\u6027\u3001\u771f\u5b9e\u6027\u8fdb\u884c\u6838\u9a8c\u3002\u82e5\u7b26\u5408\u6536\u4ef6\u6807\u51c6\uff0c\u7cfb\u7edf\u4f1a\u6b63\u5f0f\u751f\u6210\u4e00\u4e2a\u53d7\u7406\u7f16\u53f7\uff0c\u8fd9\u6807\u5fd7\u7740\u5b98\u65b9\u529e\u8bc1\u6d41\u7a0b\u6b63\u5f0f\u5f00\u542f\u3002</p>"},{"location":"#05-1","title":"\ud83c\udfc1 \u6b65\u9aa4\u4e8c\uff1a\u540e\u53f0\u7a0e\u8d39\u6838\u7b97\u4e0e\u6e05\u7f34\uff080.5 - 1\u4e2a\u5de5\u4f5c\u65e5\uff09","text":"<p>\u4e0d\u52a8\u4ea7\u767b\u8bb0\u4e0e\u5951\u7a0e\u3001\u5370\u82b1\u7a0e\u7b49\u7a0e\u6536\u7d27\u5bc6\u6302\u94a9\u3002\u767b\u8bb0\u7cfb\u7edf\u4f1a\u5c06\u6570\u636e\u540c\u6b65\u63a8\u9001\u5230\u7a0e\u52a1\u7cfb\u7edf\uff0c\u6838\u7b97\u4e1a\u4e3b\u5e94\u7f34\u7eb3\u7684\u5951\u7a0e\u989d\u5ea6\u3002\u4e1a\u4e3b\u5728\u5b8c\u6210\u7ebf\u4e0a\u6216\u7ebf\u4e0b\u7f34\u7a0e\u5e76\u53d6\u5f97\u5b8c\u7a0e\u51ed\u8bc1\u540e\uff0c\u6d41\u7a0b\u624d\u4f1a\u6d41\u8f6c\u5230\u4e0b\u4e00\u4e2a\u5ba1\u6279\u73af\u8282\u3002</p>"},{"location":"#1-2","title":"\ud83c\udfc1 \u6b65\u9aa4\u4e09\uff1a\u6cd5\u5b9a\u671f\u9650\u5185\u7684\u5408\u89c4\u6027\u5ba1\u6279\uff081 - 2\u4e2a\u5de5\u4f5c\u65e5\uff09","text":"<p>\u8fd9\u662f\u786e\u4fdd\u623f\u4ea7\u4ea7\u6743\u5b89\u5168\u7684\u6700\u6838\u5fc3\u73af\u8282\u3002\u5ba1\u6279\u4eba\u5458\u4f1a\u5728\u7cfb\u7edf\u540e\u53f0\u8c03\u53d6\u8be5\u5957\u623f\u4ea7\u7684\u89c4\u5212\u4fe1\u606f\u3001\u6d4b\u7ed8\u6570\u636e\u3001\u6709\u65e0\u67e5\u5c01\u3001\u6709\u65e0\u62b5\u62bc\u7b49\u5b9e\u65f6\u72b6\u6001\u8fdb\u884c\u6bd4\u5bf9\uff0c\u786e\u8ba4\u8be5\u623f\u4ea7\u5177\u5907\u5408\u6cd5\u7684\u767b\u8bb0\u6761\u4ef6\uff0c\u5e76\u5728\u7cfb\u7edf\u4e2d\u7b7e\u7f72\u51c6\u4e88\u767b\u8bb0\u7684\u610f\u89c1\u3002</p>"},{"location":"#05","title":"\ud83c\udfc1 \u6b65\u9aa4\u56db\uff1a\u5b98\u65b9\u5236\u4f5c\u4e0e\u6253\u5370\u8bc1\u4e66\uff08\u5373\u201c\u7f2e\u8bc1\u201d\u73af\u8282\uff0c0.5\u4e2a\u5de5\u4f5c\u65e5\uff09","text":"<p>\u5f53\u7cfb\u7edf\u663e\u793a\u201c\u5ba1\u6279\u901a\u8fc7\u201d\u540e\uff0c\u6d41\u7a0b\u6b63\u5f0f\u8fdb\u5165\u5236\u8bc1\u673a\u623f\u3002\u6240\u8c13\u7684\u201c\u5b98\u65b9\u5236\u4f5c\u201d\uff0c\u5728\u884c\u653f\u672f\u8bed\u4e2d\u88ab\u79f0\u4e3a\u201c\u7f2e\u8bc1\u201d\u3002 \u5de5\u4f5c\u4eba\u5c06\u5e26\u6709\u5168\u56fd\u7edf\u4e00\u7f16\u53f7\u7684\u4e0d\u52a8\u4ea7\u6743\u8bc1\u4e66\u7a7a\u767d\u672c\u653e\u5165\u4e13\u7528\u9ad8\u7cbe\u6253\u5370\u673a\u4e2d\uff0c\u5c06\u4e1a\u4e3b\u7684\u59d3\u540d\u3001\u8eab\u4efd\u8bc1\u53f7\u3001\u5750\u843d\u5730\u5740\u3001\u5171\u6709\u60c5\u51b5\u3001\u767b\u8bb0\u65f6\u95f4\u3001\u4e13\u6709\u5efa\u7b51\u9762\u79ef\u3001\u5206\u644a\u5efa\u7b51\u9762\u79ef\u4ee5\u53ca\u552f\u4e00\u7684\u4e0d\u52a8\u4ea7\u5355\u5143\u53f7\u7b49\u5173\u952e\u9632\u4f2a\u4fe1\u606f\u6253\u5370\u4e0a\u8bc1\uff0c\u5e76\u52a0\u76d6\u4e0d\u52a8\u4ea7\u767b\u8bb0\u4e2d\u5fc3\u7684\u9632\u4f2a\u7535\u5b50\u516c\u7ae0\u6216\u5b9e\u4f53\u5370\u7ae0\u3002\u81f3\u6b64\uff0c\u8bc1\u4e66\u5236\u4f5c\u6b63\u5f0f\u5b8c\u6210\u3002</p>"},{"location":"#_5","title":"\u4e09\u3001 \u65b0\u623f\u529e\u623f\u4ea7\u8bc1\u6750\u6599\u6e05\u5355\uff1a\u53bb\u7a97\u53e3\u524d\u5fc5\u987b\u5e26\u9f50\u54ea\u4e9b\u539f\u4ef6\uff1f","text":"<p>\u5728\u641c\u7d22\u6307\u6570\u4e2d\uff0c\u201c\u529e\u623f\u4ea7\u8bc1\u9700\u8981\u4ec0\u4e48\u6750\u6599\u201d\u5f80\u5f80\u662f\u56e0\u4e3a\u4e1a\u4e3b\u6750\u6599\u5e26\u4e0d\u9f50\u5bfc\u81f4\u201c\u9000\u4ef6\u201d\u3001\u4ece\u800c\u65e0\u5f62\u4e2d\u62c9\u957f\u4e86\u529e\u8bc1\u5468\u671f\u3002\u4e3a\u4e86\u786e\u4fdd\u5b98\u65b9\u80fd\u4e00\u6b21\u6027\u53d7\u7406\u5e76\u987a\u5229\u5236\u4f5c\u8bc1\u4e66\uff0c\u8bf7\u52a1\u5fc5\u63d0\u524d\u51c6\u5907\u597d\u4ee5\u4e0b\u6750\u6599\uff1a</p> <ul> <li>\u8eab\u4efd\u8bc1\u660e\u7c7b\uff1a \u8d2d\u623f\u4eba\u672c\u4eba\u7684\u8eab\u4efd\u8bc1\u539f\u4ef6\u3001\u6237\u53e3\u7c3f\u539f\u4ef6\uff1b\u82e5\u5df2\u5a5a\uff0c\u9700\u63d0\u4f9b\u7ed3\u5a5a\u8bc1\uff1b\u82e5\u5c5e\u4e8e\u591a\u540d\u5b50\u5973\u6216\u5171\u540c\u4e70\u623f\uff0c\u6240\u6709\u4eba\u5747\u9700\u5230\u573a\u5e76\u63d0\u4f9b\u8eab\u4efd\u8bc1\u660e\u3002</li> <li>\u4ea4\u6613\u51ed\u8bc1\u7c7b\uff1a \u7ecf\u7f51\u7b7e\u5907\u6848\u7684\u5546\u54c1\u623f\u4e70\u5356\u5408\u540c\u539f\u4ef6\u3002</li> <li>\u8d44\u91d1\u4e0e\u7a0e\u8d39\u7c7b\uff1a \u8d2d\u623f\u5168\u6b3e\u53d1\u7968\uff08\u5305\u542b\u9996\u4ed8\u6b3e\u53d1\u7968\u53ca\u5c3e\u6b3e\u53d1\u7968\uff09\u539f\u4ef6\u3001\u623f\u5c4b\u4e13\u9879\u7ef4\u4fee\u57fa\u91d1\u7f34\u5b58\u51ed\u8bc1\u3002</li> <li>\u6280\u672f\u6d4b\u7ed8\u7c7b\uff1a \u623f\u5c4b\u6d4b\u7ed8\u6210\u679c\u56fe\u3001\u5206\u6237\u56fe\uff08\u901a\u5e38\u7531\u5f00\u53d1\u5546\u7edf\u4e00\u63d0\u4f9b\u6216\u7531\u767b\u8bb0\u4e2d\u5fc3\u5185\u90e8\u7cfb\u7edf\u76f4\u63a5\u8c03\u53d6\uff09\u3002</li> </ul>"},{"location":"#_6","title":"\u56db\u3001 \u5f71\u54cd\u529e\u8bc1\u901f\u5ea6\u7684\u9690\u5f62\u56e0\u7d20\uff1a\u4e3a\u4ec0\u4e48\u4f60\u7684\u8bc1\u4e66\u8fdf\u8fdf\u65e0\u6cd5\u5236\u4f5c\uff1f","text":"<p>\u6709\u65f6\u5019\uff0c\u867d\u7136\u4e2a\u4eba\u6750\u6599\u51c6\u5907\u5f97\u5f88\u5145\u5206\uff0c\u4f46\u8bc1\u4e66\u7684\u5b98\u65b9\u5236\u4f5c\u4f9d\u7136\u4f1a\u5361\u58f3\uff0c\u8fd9\u901a\u5e38\u662f\u7531\u4ee5\u4e0b\u51e0\u4e2a\u5916\u90e8\u56e0\u7d20\u5bfc\u81f4\u7684\uff1a</p> <ol> <li>\u5f00\u53d1\u5546\u201c\u5927\u8bc1\u201d\u672a\u529e\u59a5\uff1a \u5546\u54c1\u623f\u5c5e\u4e8e\u6574\u4f53\u89c4\u5212\u3002\u5982\u679c\u5f00\u53d1\u5546\u7531\u4e8e\u6d88\u9632\u672a\u9a8c\u6536\u3001\u89c4\u5212\u8fdd\u5efa\u3001\u6b20\u7f34\u571f\u5730\u51fa\u8ba9\u91d1\u7b49\u539f\u56e0\u672a\u80fd\u62ff\u5230\u521d\u59cb\u767b\u8bb0\uff08\u5927\u8bc1\uff09\uff0c\u90a3\u4e48\u767b\u8bb0\u4e2d\u5fc3\u662f\u7edd\u5bf9\u65e0\u6cd5\u4e3a\u4efb\u4f55\u4e00\u4f4d\u5355\u72ec\u7684\u4e1a\u4e3b\u5236\u4f5c\u201c\u5c0f\u8bc1\u201d\u7684\u3002</li> <li>\u623f\u4ea7\u5b58\u5728\u6743\u5229\u9650\u5236\uff1a \u5982\u679c\u8be5\u5957\u623f\u4ea7\u5728\u4ea4\u6613\u8fc7\u7a0b\u4e2d\uff0c\u56e0\u4e3a\u67d0\u4e9b\u7ecf\u6d4e\u7ea0\u7eb7\u88ab\u6cd5\u9662\u5b9e\u884c\u4e86\u201c\u53f8\u6cd5\u67e5\u5c01\u201d\uff0c\u6216\u8005\u5f00\u53d1\u5546\u5728\u5168\u6b3e\u6536\u9f50\u540e\u672a\u53ca\u65f6\u89e3\u9664\u8be5\u623f\u4ea7\u7684\u6574\u4f53\u62b5\u62bc\uff0c\u5236\u8bc1\u7cfb\u7edf\u5c31\u4f1a\u81ea\u52a8\u89e6\u53d1\u9501\u5b9a\u62e6\u622a\uff0c\u65e0\u6cd5\u8fdb\u5165\u5236\u4f5c\u6d41\u7a0b\u3002</li> <li>\u6d4b\u7ed8\u6570\u636e\u4e0d\u4e00\u81f4\uff1a \u5b9e\u9645\u6d4b\u7ed8\u51fa\u7684\u623f\u5c4b\u9762\u79ef\u5982\u679c\u4e0e\u5408\u540c\u7ea6\u5b9a\u7684\u9884\u6d4b\u9762\u79ef\u8bef\u5dee\u8d85\u51fa\u6cd5\u5b9a\u8303\u56f4\uff0c\u9700\u8981\u5f00\u53d1\u5546\u4e0e\u4e1a\u4e3b\u5148\u8fdb\u884c\u9762\u79ef\u5dee\u4ef7\u6e05\u7b97\uff0c\u66f4\u6539\u5408\u540c\u6570\u636e\u540e\uff0c\u5b98\u65b9\u624d\u80fd\u4f9d\u636e\u6700\u7ec8\u51c6\u786e\u6570\u636e\u5236\u4f5c\u8bc1\u4e66\u3002</li> </ol>"},{"location":"#_7","title":"\u4e94\u3001 \u4fbf\u6c11\u65b0\u8d8b\u52bf\uff1a\u7535\u5b50\u4e0d\u52a8\u4ea7\u6743\u8bc1\u4e66\u4e0e\u7eb8\u8d28\u8bc1\u4e66\u5177\u6709\u540c\u7b49\u6548\u529b\u5417\uff1f","text":"<p>\u968f\u7740\u6570\u5b57\u653f\u52a1\u7684\u666e\u53ca\uff0c\u591a\u5730\u5df2\u7ecf\u5728\u5b98\u65b9\u5236\u4f5c\u7eb8\u8d28\u8bc1\u4e66\u7684\u540c\u65f6\uff0c\u540c\u6b65\u751f\u6210\u7535\u5b50\u4e0d\u52a8\u4ea7\u6743\u8bc1\u4e66\u3002</p> <p>\u8bb8\u591a\u4e1a\u4e3b\u597d\u5947\uff1a\u7535\u5b50\u8bc1\u4e66\u6709\u7528\u5417\uff1f \u7b54\u6848\u662f\u80af\u5b9a\u7684\u3002\u6839\u636e\u56fd\u5bb6\u76f8\u5173\u89c4\u5b9a\uff0c\u7ecf\u7531\u5b98\u65b9\u5236\u8bc1\u7cfb\u7edf\u751f\u6210\u3001\u52a0\u76d6\u7535\u5b50\u5370\u7ae0\u7684\u7535\u5b50\u4e0d\u52a8\u4ea7\u6743\u8bc1\u4e66\uff0c\u5728\u6cd5\u5f8b\u6548\u529b\u3001\u5b89\u5168\u9632\u4f2a\u6027\u80fd\u4e0a\u4e0e\u7eb8\u8d28\u8bc1\u4e66\u5b8c\u5168\u4e00\u81f4\u3002\u5728\u540e\u7eed\u529e\u7406\u5b50\u5973\u5165\u5b66\u3001\u6237\u53e3\u51c6\u8fc1\u3001\u94f6\u884c\u62b5\u62bc\u8d37\u6b3e\u7b49\u65e5\u5e38\u529e\u4e8b\u573a\u666f\u4e2d\uff0c\u76f4\u63a5\u51fa\u793a\u624b\u673a\u653f\u52a1App\u4e2d\u7684\u7535\u5b50\u8bc1\u4e66\uff0c\u5373\u53ef\u4eab\u53d7\u540c\u7b49\u7684\u884c\u653f\u5ba1\u6279\u5f85\u9047\uff0c\u5927\u5927\u51cf\u5c11\u4e86\u56e0\u643a\u5e26\u7eb8\u8d28\u8bc1\u4e66\u9057\u5931\u7684\u98ce\u9669\u3002</p> <p>\u603b\u7ed3\uff1a \u5982\u4eca\u7684\u4e0d\u52a8\u4ea7\u6743\u8bc1\u4e66\u4ece\u529e\u7406\u5230\u5b98\u65b9\u5236\u4f5c\uff0c\u5728\u6d41\u7a0b\u7545\u901a\u7684\u60c5\u51b5\u4e0b\uff0c\u666e\u904d\u53ea\u9700\u89813\u81f35\u4e2a\u5de5\u4f5c\u65e5\u3002\u8d2d\u623f\u8005\u5728\u4ea4\u623f\u540e\uff0c\u5e94\u5c3d\u65e9\u5411\u5f00\u53d1\u5546\u7d22\u8981\u76f8\u5173\u6d4b\u7ed8\u8d44\u6599\uff0c\u53ca\u65f6\u524d\u5f80\u7a97\u53e3\u6216\u7ebf\u4e0a\u63d0\u4ea4\u7533\u8bf7\uff0c\u5c3d\u65e9\u5b8c\u6210\u5b98\u65b9\u786e\u6743\u5236\u4f5c\uff0c\u8ba9\u81ea\u5df1\u7684\u623f\u4ea7\u771f\u6b63\u62e5\u6709\u5408\u6cd5\u7684\u6cd5\u5f8b\u4fdd\u62a4\u4f1e\u3002</p>"}]}